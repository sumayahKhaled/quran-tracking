    </main>

    <div id="modalOverlay" class="modal-overlay">
        <div class="modal-card">
            <div id="modalIconWrapper" class="modal-icon-wrapper modal-icon-success">
                <i id="modalIcon" class="fa-solid fa-award"></i>
            </div>
            <h3 id="modalTitle" class="modal-title">مبارك إنجاز اليوم!</h3>
            <p id="modalMessage" class="modal-text">تم حفظ التقدم بنجاح. هنيئاً لك هذه الخطوة المباركة في طريق إتقان كتاب الله تعالى.</p>
            <div id="modalButtons" class="modal-buttons">
                <button id="modalCloseBtn" class="btn-modal btn-modal-primary" type="button">إغلاق</button>
            </div>
        </div>
    </div>

    <script>
        // Offline Service Worker Registration
        if ('serviceWorker' in navigator && (window.location.protocol === 'https:' || window.location.hostname === 'localhost')) {
            window.addEventListener('load', () => {
                const swCode = `
                    const CACHE_NAME = 'quran-tracker-v3';
                    self.addEventListener('install', (e) => self.skipWaiting());
                    self.addEventListener('activate', (e) => e.waitUntil(clients.claim()));
                    self.addEventListener('fetch', (e) => {
                        e.respondWith(
                            caches.match(e.request).then((res) => res || fetch(e.request).then((netRes) => {
                                return caches.open(CACHE_NAME).then((cache) => {
                                    try { cache.put(e.request, netRes.clone()); } catch(err) {}
                                    return netRes;
                                });
                            }).catch(() => caches.match('.')))
                        );
                    });
                `;
                try {
                    const blob = new Blob([swCode], { type: 'application/javascript' });
                    const blobUrl = URL.createObjectURL(blob);
                    navigator.serviceWorker.register(blobUrl).catch(() => {});
                } catch (e) {}
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            const currentDateDisplay = document.getElementById('currentDateDisplay');
            const offlineIndicator = document.getElementById('offlineIndicator');
            const checkboxes = document.querySelectorAll('.task-checkbox');
            const progressPercentage = document.getElementById('progressPercentage');
            const progressBar = document.getElementById('progressBar');
            
            const repCounter = document.getElementById('repCounter');
            const incrementRep = document.getElementById('incrementRep');
            const decrementRep = document.getElementById('decrementRep');
            const repTargetCheckbox = document.getElementById('repTargetCheckbox');

            const prevRepCounter = document.getElementById('prevRepCounter');
            const incrementPrevRep = document.getElementById('incrementPrevRep');
            const decrementPrevRep = document.getElementById('decrementPrevRep');
            const prevRepTargetCheckbox = document.getElementById('prevRepTargetCheckbox');

            const assignedPart = document.getElementById('assignedPart');
            const saveBtn = document.getElementById('saveBtn');
            const resetBtn = document.getElementById('resetBtn');

            const modalOverlay = document.getElementById('modalOverlay');
            const modalIconWrapper = document.getElementById('modalIconWrapper');
            const modalIcon = document.getElementById('modalIcon');
            const modalTitle = document.getElementById('modalTitle');
            const modalMessage = document.getElementById('modalMessage');
            const modalButtons = document.getElementById('modalButtons');
            const modalCloseBtn = document.getElementById('modalCloseBtn');

            // Network status monitor
            function updateOnlineStatus() {
                if (navigator.onLine) {
                    offlineIndicator.classList.remove('active');
                } else {
                    offlineIndicator.classList.add('active');
                }
            }
            window.addEventListener('online', updateOnlineStatus);
            window.addEventListener('offline', updateOnlineStatus);
            updateOnlineStatus();

            // Safe Arabic Date Format
            try {
                const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                currentDateDisplay.textContent = new Date().toLocaleDateString('ar-SA', options);
            } catch (e) {
                currentDateDisplay.textContent = new Date().toLocaleDateString();
            }

            let counterVal = 0;
            let prevCounterVal = 0;

            function updateProgress() {
                repTargetCheckbox.checked = (counterVal >= 10);
                prevRepTargetCheckbox.checked = (prevCounterVal >= 5);

                let totalWeight = 0;
                let completedWeight = 0;

                checkboxes.forEach(cb => {
                    const weight = parseInt(cb.getAttribute('data-weight') || '1');
                    totalWeight += weight;
                    if (cb.checked) {
                        completedWeight += weight;
                    }
                });

                const percentage = totalWeight > 0 ? Math.round((completedWeight / totalWeight) * 100) : 0;
                progressPercentage.textContent = percentage + '%';
                progressBar.style.width = percentage + '%';

                saveStateSilently();
                return percentage;
            }

            incrementRep.addEventListener('click', function() {
                if (counterVal < 10) {
                    counterVal++;
                    repCounter.textContent = counterVal;
                    updateProgress();
                }
            });

            decrementRep.addEventListener('click', function() {
                if (counterVal > 0) {
                    counterVal--;
                    repCounter.textContent = counterVal;
                    updateProgress();
                }
            });

            incrementPrevRep.addEventListener('click', function() {
                if (prevCounterVal < 5) {
                    prevCounterVal++;
                    prevRepCounter.textContent = prevCounterVal;
                    updateProgress();
                }
            });

            decrementPrevRep.addEventListener('click', function() {
                if (prevCounterVal > 0) {
                    prevCounterVal--;
                    prevRepCounter.textContent = prevCounterVal;
                    updateProgress();
                }
            });

            checkboxes.forEach(cb => {
                cb.addEventListener('change', updateProgress);
            });

            assignedPart.addEventListener('input', function() {
                saveStateSilently();
            });

            function saveStateSilently() {
                const state = {
                    assignedPart: assignedPart.value,
                    counterVal: counterVal,
                    prevCounterVal: prevCounterVal,
                    checkboxesState: Array.from(checkboxes).map(cb => cb.checked)
                };
                try {
                    localStorage.setItem('quranProgressState', JSON.stringify(state));
                } catch (e) {}
            }

            function loadState() {
                const saved = localStorage.getItem('quranProgressState');
                if (saved) {
                    try {
                        const state = JSON.parse(saved);
                        if (state.assignedPart !== undefined) assignedPart.value = state.assignedPart;
                        if (typeof state.counterVal === 'number') {
                            counterVal = state.counterVal;
                            repCounter.textContent = counterVal;
                        }
                        if (typeof state.prevCounterVal === 'number') {
                            prevCounterVal = state.prevCounterVal;
                            prevRepCounter.textContent = prevCounterVal;
                        }
                        if (Array.isArray(state.checkboxesState)) {
                            checkboxes.forEach((cb, idx) => {
                                if (state.checkboxesState[idx] !== undefined) {
                                    cb.checked = state.checkboxesState[idx];
                                }
                            });
                        }
                    } catch(e) {}
                }
                updateProgress();
            }

            const toggleMicBtn = document.getElementById('toggleMicBtn');
            const micRecorderPanel = document.getElementById('micRecorderPanel');
            const startRecBtn = document.getElementById('startRecBtn');
            const stopRecBtn = document.getElementById('stopRecBtn');
            const recStatusText = document.getElementById('recStatusText');
            const audioPlayback = document.getElementById('audioPlayback');

            let mediaRecorder = null;
            let audioChunks = [];
            let currentAudioObjectUrl = null;

            toggleMicBtn.addEventListener('click', () => {
                micRecorderPanel.classList.toggle('hidden');
            });

            startRecBtn.addEventListener('click', async () => {
                if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                    try {
                        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                        mediaRecorder = new MediaRecorder(stream);
                        audioChunks = [];

                        mediaRecorder.ondataavailable = event => {
                            if (event.data.size > 0) audioChunks.push(event.data);
                        };

                        mediaRecorder.onstop = () => {
                            if (currentAudioObjectUrl) URL.revokeObjectURL(currentAudioObjectUrl);
                            const audioBlob = new Blob(audioChunks, { type: 'audio/wav' });
                            currentAudioObjectUrl = URL.createObjectURL(audioBlob);
                            audioPlayback.src = currentAudioObjectUrl;
                            audioPlayback.classList.remove('hidden');
                            recStatusText.textContent = "تم التسجيل بنجاح! يمكنك الاستماع لتلاوتك الآن.";

                            stream.getTracks().forEach(track => track.stop());
                        };

                        mediaRecorder.start();
                        startRecBtn.disabled = true;
                        startRecBtn.style.opacity = '0.5';
                        stopRecBtn.disabled = false;
                        stopRecBtn.classList.add('active');
                        recStatusText.textContent = "جاري التسجيل الآن... تحدثي بصوت واضح";
                    } catch (err) {
                        recStatusText.textContent = "عذراً، تعذر الوصول للميكروفون. تأكدي من إعطاء الإذن للمتصفح.";
                    }
                } else {
                    recStatusText.textContent = "التسجيل الصوتي غير مدعوم في هذا المتصفح أو يحتاج رابط أمان (HTTPS).";
                }
            });

            stopRecBtn.addEventListener('click', () => {
                if (mediaRecorder && mediaRecorder.state !== "inactive") {
                    mediaRecorder.stop();
                    startRecBtn.disabled = false;
                    startRecBtn.style.opacity = '1';
                    stopRecBtn.disabled = true;
                    stopRecBtn.classList.remove('active');
                }
            });

            function showCustomModal(title, text, isWarning = false, onConfirm = null) {
                modalTitle.textContent = title;
                modalMessage.textContent = text;

                if (isWarning) {
                    modalIconWrapper.className = "modal-icon-wrapper modal-icon-warning";
                    modalIcon.className = "fa-solid fa-triangle-exclamation";
                } else {
                    modalIconWrapper.className = "modal-icon-wrapper modal-icon-success";
                    modalIcon.className = "fa-solid fa-award";
                }

                modalButtons.innerHTML = '';
                if (onConfirm) {
                    const confirmBtn = document.createElement('button');
                    confirmBtn.className = "btn-modal btn-modal-primary";
                    confirmBtn.textContent = "نعم، تأكيد";
                    confirmBtn.type = "button";
                    confirmBtn.addEventListener('click', () => {
                        onConfirm();
                        hideCustomModal();
                    });

                    const cancelBtn = document.createElement('button');
                    cancelBtn.className = "btn-modal btn-modal-secondary";
                    cancelBtn.textContent = "إلغاء";
                    cancelBtn.type = "button";
                    cancelBtn.addEventListener('click', hideCustomModal);

                    modalButtons.appendChild(confirmBtn);
                    modalButtons.appendChild(cancelBtn);
                } else {
                    const closeBtn = document.createElement('button');
                    closeBtn.className = "btn-modal btn-modal-primary";
                    closeBtn.textContent = "إغلاق";
                    closeBtn.type = "button";
                    closeBtn.addEventListener('click', hideCustomModal);
                    modalButtons.appendChild(closeBtn);
                }

                modalOverlay.classList.add('active');
            }

            function hideCustomModal() {
                modalOverlay.classList.remove('active');
            }

            modalCloseBtn.addEventListener('click', hideCustomModal);

            saveBtn.addEventListener('click', function() {
                saveStateSilently();
                const pct = updateProgress();
                const title = pct === 100 ? "مبارك إكمال الجدول اليومي!" : "تم حفظ التقدم!";
                const message = pct === 100 
                    ? "ما شاء الله! لقد أكملتِ كافة مهام الحفظ والتثبيت والمراجعة لهذا اليوم بنجاح."
                    : `تم حفظ الإنجاز الحالي بنسبة (${pct}%). واصلي التوفيق والهمة العالية!`;
                
                showCustomModal(title, message, false);
            });

            // Smooth collapse on scroll for sticky header
            const stickyCard = document.querySelector('.sticky-progress-card');
            window.addEventListener('scroll', function() {
                if (window.scrollY > 50) {
                    stickyCard.classList.add('scrolled');
                } else {
                    stickyCard.classList.remove('scrolled');
                }
            }, { passive: true });

            resetBtn.addEventListener('click', function() {
                showCustomModal(
                    "إعادة ضبط الجدول",
                    "هل أنتِ متأكدة من إرجاع ضبط العدادات وإلغاء تحديد كافة الخانات لليوم؟",
                    true,
                    function() {
                        checkboxes.forEach(cb => cb.checked = false);
                        counterVal = 0;
                        prevCounterVal = 0;
                        repCounter.textContent = 0;
                        prevRepCounter.textContent = 0;
                        assignedPart.value = '';
                        localStorage.removeItem('quranProgressState');
                        updateProgress();
                    }
                );
            });

            // Load preserved progress state
            loadState();
        });
    </script>
